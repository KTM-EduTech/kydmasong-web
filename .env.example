# Copy to .env.local for local development, and add the same variables in
# Netlify (Site configuration > Environment variables) or Vercel (Project > Settings > Environment Variables).

# --- Supabase (Project Settings > API). Both are public by design: RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://jlrautcvymkslmtvdwpx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Public site address (used for canonical URLs, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.kydmasong.net

# --- Cloudflare Turnstile spam protection for the contact form (optional but recommended).
# Create a free widget at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Secret for the daily keep-alive call (/api/keepalive). Any long random string.
CRON_SECRET=

# Never add the Supabase service_role key or database password to the website's environment.
# They are only needed for the backup GitHub Action (as GitHub secrets).
